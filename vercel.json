{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    { "source": "/journal/volodymyr-i-tramp(/?)", "destination": "/journal/nobel-plache/", "permanent": true },
    { "source": "/audio/volodymyr-i-tramp.mp3", "destination": "/audio/nobel-plache.mp3", "permanent": true }
  ],
  "rewrites": [
    { "source": "/js/script.js", "destination": "https://plausible.io/js/script.js" },
    { "source": "/api/event", "destination": "https://plausible.io/api/event" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/comments.v1.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/lead-form.v1.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/subscribe.v2.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, s-maxage=1800" }
      ]
    },
    {
      "source": "/:section/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, s-maxage=1800" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/comments-retention/", "schedule": "0 3 * * *" },
    { "path": "/api/cron/subscribers-retention/", "schedule": "30 3 * * *" }
  ]
}
